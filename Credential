---
- name: Create Tower Credential
  hosts: localhost
  gather_facts: no

  vars:
    tower_url: "https://your-tower-instance.com"
    tower_token: "your-tower-token"
    organization_name: "Your Organization"
    credential_name: "My Credential"
    credential_description: "My credential description"
    credential_kind: "machine"  # or "source_control"
    credential_username: "your-username"
    credential_password: "your-password"
    credential_ssh_key: "your-ssh-private-key"
    credential_scm_passphrase: "your-scm-passphrase"

  tasks:
  - name: Get organization ID
    uri:
      url: "{{ tower_url }}/api/v2/organizations/"
      method: GET
      headers:
        Authorization: "Bearer {{ tower_token }}"
      body_format: json
    register: organizations

  - name: Set organization ID
    set_fact:
      organization_id: "{{ organizations.json.results | selectattr('name', 'equalto', organization_name) | map(attribute='id') | first }}"

  - name: Create machine credential
    uri:
      url: "{{ tower_url }}/api/v2/organizations/{{ organization_id }}/credentials/"
      method: POST
      headers:
        Authorization: "Bearer {{ tower_token }}"
      body:
        name: "{{ credential_name }}"
        description: "{{ credential_description }}"
        kind: "machine"
        username: "{{ credential_username }}"
        password: "{{ credential_password }}"
        ssh_key_data: "{{ credential_ssh_key }}"
      body_format: json
      status_code: 201
    when: credential_kind == "machine"

  - name: Create source control credential
    uri:
      url: "{{ tower_url }}/api/v2/organizations/{{ organization_id }}/credentials/"
      method: POST
      headers:
        Authorization: "Bearer {{ tower_token }}"
      body:
        name: "{{ credential_name }}"
        description: "{{ credential_description }}"
        kind: "source_control"
        username: "{{ credential_username }}"
        password: "{{ credential_password }}"
        scm_passphrase: "{{ credential_scm_passphrase }}"
      body_format: json
      status_code: 201
    when: credential_kind == "source_control"
